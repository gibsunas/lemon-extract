{
    "compilerOptions": {
        "composite": true,
        "target": "ES2022",
        "rootDir": "lib/",
        "skipLibCheck": true,
        "sourceMap": true,
        "declaration": true,
        "emitDecoratorMetadata": true,
        "experimentalDecorators": true,
        "importHelpers": true,
        "allowSyntheticDefaultImports": true,
        "esModuleInterop": true,
        "tsBuildInfoFile": "dist/.tsbuildinfo",
        "types": ["node", "jest"],
        "lib": ["ES2022", "DOM"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "baseUrl": ".",
        "outDir": "dist",
        "paths": {
            "@lemon/extract/*": ["./lib/*"]
        }
    },
    "include": ["lib/**/*"],
    "exclude": ["node_modules", "dist"]
}
